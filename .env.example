# 复制为 .env 并填入你自己的值
# 小智 AI 的 MCP 接入点（小智控制台 → 智能体 → MCP 接入点）
MCP_ENDPOINT=wss://api.xiaozhi.me/mcp/?token=你的接入点token
# 商户 ID（与数据库 merchants 表对应，seed 后为 demo-store）
CASHIER_MERCHANT_ID=demo-store
# 设备序列号（小智设备信息页可查）
CASHIER_DEVICE_SN=xx:xx:xx:xx:xx:xx
# 屏幕推图服务端口
SCREEN_PORT=8801
# 屏幕分辨率（ST7789 常见 240x320）
SCREEN_W=240
SCREEN_H=320
